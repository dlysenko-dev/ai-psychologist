# AI Psychologist — Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_psychologist

# AI (OpenClaw gateway — uses Claude Code subscription)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
AI_MODEL=claude-sonnet-4-20250514
AI_FALLBACK_MODEL=claude-sonnet-4-20250514

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
MINI_APP_URL=https://your-domain.com/miniapp
ADMIN_TELEGRAM_ID=756877849

# Auth (JWT secret for Mini App)
APP_SECRET_KEY=change-me-to-random-string

# Server
BACKEND_PORT=8010
LOG_LEVEL=INFO
